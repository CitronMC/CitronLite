// The exe's icon and the version Explorer and Task Manager show.
#include <windows.h>

1 ICON "assets/citron-lite.ico"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"
        {
            VALUE "CompanyName",      "Citron\0"
            VALUE "FileDescription",  "Citron Lite\0"
            VALUE "FileVersion",      "2.0.0.0\0"
            VALUE "LegalCopyright",   "GPL-3.0\0"
            VALUE "ProductName",      "Citron Lite\0"
            VALUE "ProductVersion",   "2.0.0.0\0"
            VALUE "OriginalFilename", "CitronLite.exe\0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 0x04B0
    }
}
